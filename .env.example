# Copy to .env and fill in. Never commit .env.

# Answers (P2-08) and the judge (P2-10).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# The judge can be a cheaper model. Check that it agrees with your labels (npm run eval:calibrate).
JUDGE_MODEL=claude-haiku-4-5

# Postgres with pgvector. `npm run db:up` starts one on this URL with Docker.
DATABASE_URL=postgres://rag:rag@localhost:5433/rag

# Which docs to fetch, ingest and cite: nextjs (default) or react-native.
# Switching means docs:fetch, ingest and a new golden set for that source.
DOCS_SOURCE=nextjs
# Where docs:fetch puts the clones.
CORPUS_DIR=corpus

# fake works offline (hashed bag of words, fine for wiring things up).
# Switch to voyage once P2-04 is done, then re-run `npm run ingest`.
EMBEDDER=fake
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3.5

# fake scores word overlap offline. voyage uses the rerank model below (P2-07).
RERANKER=fake
VOYAGE_RERANK_MODEL=rerank-2.5

# Chunking experiments (P2-01): override the defaults in src/chunk.ts, then re-ingest.
# CHUNK_MAX_CHARS=2000
# CHUNK_OVERLAP=200

PORT=3000
