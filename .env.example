# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Model used as the LLM judge in evals (a cheaper model is usually fine; check it agrees with you).
JUDGE_MODEL=claude-haiku-4-5

DATABASE_URL=postgres://rag:rag@localhost:5433/rag

# "fake" works offline (hashed bag of words, good for wiring things up).
# Switch to "voyage" after TODO(P2-02) and re-run `npm run ingest`.
EMBEDDER=fake
VOYAGE_API_KEY=
